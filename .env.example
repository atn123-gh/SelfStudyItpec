# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit it. This file documents every variable the app reads;
# see itp_project/itp_project/settings/*.py for where each is used.

#### Django ####

# Comma-separated list of hostnames/IPs this deployment is served from.
# "localhost", "0.0.0.0", "127.0.0.1" are already always allowed for local
# dev (hardcoded in settings/local.py) — you only need to add anything
# beyond that here, e.g. a droplet's public IP for a non-local deployment.
DJANGO_ALLOWED_HOSTS=localhost

# Generate a fresh one per deployment — never reuse the same key across
# environments. Run:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key

# Note: entrypoint.sh currently force-sets DJANGO_DEBUG=True at container
# startup regardless of this value (a known quirk — see README). The app
# always runs under settings/local.py via `runserver`, not gunicorn. This
# var is kept for clarity/consistency but has no effect on the running
# container as currently set up.
DJANGO_DEBUG=True

#### PostgreSQL ####
# HOST must stay "db" — that's the docker-compose service name the app
# container resolves over the internal Docker network. Only change NAME/
# USER/PASSWORD, and only if you also update utils/init.sql to match.
POSTGRES_NAME=itpdb
POSTGRES_USER=itp_user
POSTGRES_PASSWORD=changeme-choose-a-real-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

#### MongoDB ####
# HOST must stay "mongodb://mongodb:27017" — the docker-compose service
# name. USERNAME/PASSWORD are used both by the app AND by docker-compose
# to set up MongoDB's actual root credentials — change these to whatever
# you want, no need to touch docker-compose.yml separately.
MONGO_DB_NAME=mongo_db
MONGO_DB_HOST=mongodb://mongodb:27017
MONGO_DB_USERNAME=root
MONGO_DB_PASSWORD=example

#### App container ####
# Which port on THIS machine the app is reachable at (host side only —
# the container always listens on 8000 internally). Defaults to 8000 if
# unset. Set to 80 for a deployment you want reachable as http://<ip>
# with no port number.
APP_HOST_PORT=8000

#### Optional ####
# Only used by the `insertsolutions` management command (not run
# automatically by entrypoint.sh). Leave blank if you don't use it.
OPENAI_API_KEY=

# Error tracking (Sentry). Leave blank to disable entirely - no DSN is
# baked into source, so a fresh clone sends no telemetry anywhere unless
# you set this.
SENTRY_DSN=
