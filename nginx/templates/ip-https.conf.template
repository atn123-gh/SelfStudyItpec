# HTTPS-via-public-IP config, for the `make up-https` deployment.
# ${SERVER_IP} is substituted by the nginx image's built-in envsubst-on-
# templates entrypoint (docker-compose.yml sets SERVER_IP + restricts
# substitution to just that var via NGINX_ENVSUBST_FILTER). Everything
# else here uses nginx's own $variables, untouched by that substitution.

upstream django_https {
    server app:8000;
}

server {
    listen 80 default_server;
    server_name _;

    # Let's Encrypt HTTP-01 challenge (used for both initial issuance and
    # renewal) - must stay plain HTTP, not redirected.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/${SERVER_IP}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_IP}/privkey.pem;

    location /static/ {
        alias /staticfiles/;
    }

    location / {
        proxy_pass http://django_https;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
